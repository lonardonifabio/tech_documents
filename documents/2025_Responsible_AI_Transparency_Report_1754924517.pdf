   <dc:description>
    <rdf:Alt>
     <rdf:li xml:lang="x-default">Two business entrepreneurs with positive emotion, greeting and introducing each other with a handshake, while getting registered for a Conference at Convention center.</rdf:li>
    </rdf:Alt>
   </dc:description>
  </rdf:Description>
 </rdf:RDF>
</x:xmpmeta>

endstream
